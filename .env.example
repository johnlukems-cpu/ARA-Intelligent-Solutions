# ------------------------------------------------------------------
# ARA Intelligent Solutions — environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ------------------------------------------------------------------

# Public base URL of the production site (used for canonical URLs,
# sitemap, Open Graph and structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Verified public contact details (leave empty until confirmed) ---
# Only values set here are shown on the website.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# International format without "+" or spaces, e.g. 597XXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Contact form delivery (server-side only) ---
# Option A: Resend (https://resend.com). Requires a verified sender domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option B: Generic webhook (e.g. n8n, Make, Zapier). Receives JSON via POST.
CONTACT_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Webhook-Secret" header.
CONTACT_WEBHOOK_SECRET=
